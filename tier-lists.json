  {
    "name": "Taiwan PvP Tier List",
    "slug": "taiwan_pvp_tier_list",
    "entity_type": "character",
    "author": "ligong0214",
    "content_type": "PvP",
    "description": "Please note that this tier list is for the Taiwan server, which is ~1 year ahead of the global server. Therefore, it may not accurately reflect the current state of the global server. Use it as a reference, but keep in mind that the meta may differ. Tiers are assigned assuming characters are fully built, disregarding their Noble Phantasms.",
    "tiers": [
      {
        "name": "SS",
        "note": "Child of the Meta. Without these, it's nearly impossible to compete with players who have them. Having them vs. not having them creates two different games. Provides an excellent gaming experience."
      },
      {
        "name": "S+",
        "note": "Factions Powerhouses. Very strong characters tied to specific factions, but don't perform as well in others. SS rank is usually reserved for those who are versatile across all factions."
      },
      {
        "name": "S",
        "note": "Overpowered. Core building blocks for their specific color/elemental teams. The game is difficult without them; they significantly improve the gameplay experience."
      },
      {
        "name": "A+",
        "note": "Unique Utility. Raw power isn't \"broken,\" but they possess irreplaceable functions or have very low investment costs, leading to a noticeable improvement in gameplay."
      },
      {
        "name": "A",
        "note": "Average/Decent. Usable but not essential. They add depth to your roster but have low usage rates. Occasionally improves the gaming experience slightly."
      },
      {
        "name": "B",
        "note": "Low ROI. The resources invested do not yield a proportional return in gameplay. Barely passing; only used out of necessity in a few specific teams."
      },
      {
        "name": "C",
        "note": "Not worth investing. Rarely used and not worth ranking."
      },
      {
        "name": "F",
        "note": "Fodder."
      }
    ],
